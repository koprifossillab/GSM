# 결과는 /data/GSM/logs/last_backup.json. 로그: /data/GSM/logs/weekly_backup.log
40 1 * * 1 /home/paleoadmin/projects/GSM/deploy/host/weekly_backup.sh >> /data/GSM/logs/weekly_backup.log 2>&1
