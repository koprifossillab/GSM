# /srv/GSM/.env 로 두는 것. 이 파일은 저장소에 두는 본이고, 실제 값은 장비에만 둔다.

# 오픈API 인증키.
GSM_KIGAM_KEY=

# 운영 비밀키. 반드시 바꾼다.
GSM_SECRET_KEY=

# 들어오는 호스트. nginx 뒤에 있으므로 서버 IP 와 이름을 적는다.
GSM_ALLOWED_HOSTS=127.0.0.1,localhost

# nginx 서브패스로 들어오면 원본 주소를 적어 둔다 (CSRF 검사에 쓰인다).
GSM_CSRF_TRUSTED_ORIGINS=

# 타일 캐시. 상류 부하를 줄인다.
GSM_TILE_CACHE_SECONDS=86400

# **운영에서는 반드시 0 이다.** CLAUDE.md "두 개의 상류 주소".
GSM_DEV_DIRECT_WMS=0
